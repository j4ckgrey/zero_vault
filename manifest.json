{
  "id": "zero.vault",
  "name": "Vault",
  "version": "2.0.3",
  "description": "A locked space of its own — catalog and search with ThePornDB metadata (Zilean / Torznab / Knaben / apiJAV / Rapidgator sources), played through the debrid service.",
  "resources": [
    "catalog",
    "stream",
    "space",
    "automation"
  ],
  "types": [
    "video"
  ],
  "idPrefixes": [
    "catalog:",
    "tpdb:",
    "rapidgator:",
    "apijav:"
  ],
  "provides": {
    "content": [
      "adult"
    ]
  },
  "zero": {
    "kind": "adult",
    "sdk": 3,
    "repo": "j4ckgrey/zero_vault",
    "branch": "main",
    "bundlePath": "dist/index.mjs",
    "bundleUrl": "https://raw.githubusercontent.com/j4ckgrey/zero_vault/release/dist/index.mjs",
    "settings": [
      {
        "key": "tpdb_token",
        "type": "secret",
        "label": "ThePornDB API token",
        "description": "From api.theporndb.net → API tokens. Search, titles and pictures need it."
      },
      {
        "key": "content_types",
        "type": "list",
        "label": "What ThePornDB search covers",
        "description": "None picked searches scenes.",
        "default": [
          "scenes",
          "movies",
          "jav"
        ],
        "options": [
          {
            "value": "scenes",
            "label": "Scenes"
          },
          {
            "value": "movies",
            "label": "Movies"
          },
          {
            "value": "jav",
            "label": "JAV"
          }
        ]
      },
      {
        "key": "zilean_url",
        "type": "url",
        "label": "Zilean",
        "description": "A Zilean instance (DMM hashlists) — the main source of releases for the catalog.",
        "placeholder": "https://zilean.example.com"
      },
      {
        "key": "torznab_url",
        "type": "url",
        "label": "Torznab (Prowlarr / Jackett)",
        "description": "Your indexer with adult (XXX) trackers."
      },
      {
        "key": "torznab_key",
        "type": "secret",
        "label": "Torznab API key"
      },
      {
        "key": "torznab_categories",
        "type": "list",
        "label": "Torznab categories",
        "default": [
          "6000",
          "6010",
          "6020",
          "6030",
          "6040",
          "6050",
          "6060",
          "6070",
          "6080",
          "6090"
        ],
        "options": [
          {
            "value": "6000",
            "label": "All XXX (6000)"
          },
          {
            "value": "6010",
            "label": "DVD (6010)"
          },
          {
            "value": "6020",
            "label": "WMV (6020)"
          },
          {
            "value": "6030",
            "label": "XviD (6030)"
          },
          {
            "value": "6040",
            "label": "x264 (6040)"
          },
          {
            "value": "6045",
            "label": "UHD (6045)"
          },
          {
            "value": "6050",
            "label": "Packs (6050)"
          },
          {
            "value": "6060",
            "label": "Image sets (6060)"
          },
          {
            "value": "6070",
            "label": "Other (6070)"
          },
          {
            "value": "6080",
            "label": "SD (6080)"
          },
          {
            "value": "6090",
            "label": "WEB-DL (6090)"
          }
        ],
        "description": "Newznab XXX categories your indexer is searched in."
      },
      {
        "key": "apijav_enabled",
        "type": "toggle",
        "label": "apiJAV",
        "description": "JAV catalog with its own player (direct HLS, no debrid).",
        "default": false
      },
      {
        "key": "apijav_url",
        "type": "url",
        "label": "apiJAV address",
        "default": "https://server.apijav.com",
        "showIf": {
          "key": "apijav_enabled",
          "equals": true
        }
      },
      {
        "key": "apijav_key",
        "type": "secret",
        "label": "apiJAV key (optional)",
        "showIf": {
          "key": "apijav_enabled",
          "equals": true
        }
      },
      {
        "key": "cached_only",
        "type": "toggle",
        "label": "Cached on debrid only",
        "description": "On: only releases the debrid has ready play. Off: picking one that isn't cached starts the download.",
        "default": true
      },
      {
        "key": "home_rails",
        "type": "list",
        "label": "Start-page rows",
        "default": []
      }
    ],
    "actions": [
      {
        "id": "status"
      },
      {
        "id": "rails-list"
      },
      {
        "id": "rails-toggle"
      },
      {
        "id": "refresh-catalogs"
      }
    ],
    "ui": {
      "tabs": [
        {
          "id": "vault",
          "label": "Vault",
          "icon": "lock",
          "group": "content",
          "description": "A locked space with its own catalog and search — ThePornDB metadata, played through debrid.",
          "sections": [
            {
              "kind": "status",
              "id": "status",
              "title": "Status",
              "source": "status"
            },
            {
              "kind": "form",
              "id": "metadata",
              "title": "Metadata",
              "fields": [
                "tpdb_token",
                "content_types"
              ]
            },
            {
              "kind": "form",
              "id": "sources",
              "title": "Sources",
              "description": "Knaben is always searched; add the ones you have.",
              "fields": [
                "zilean_url",
                "torznab_url",
                "torznab_key",
                "torznab_categories",
                "apijav_enabled",
                "apijav_url",
                "apijav_key"
              ]
            },
            {
              "kind": "form",
              "id": "playback",
              "title": "Playback",
              "fields": [
                "cached_only"
              ]
            },
            {
              "kind": "table",
              "id": "rails",
              "title": "Start-page rows",
              "description": "Lists shown when the space opens (releases cached on the debrid only).",
              "rows": "rails-list",
              "columns": [
                {
                  "key": "title",
                  "label": "List"
                },
                {
                  "key": "group",
                  "label": "Group"
                },
                {
                  "key": "enabled",
                  "label": "Shown",
                  "format": "bool",
                  "action": "rails-toggle"
                }
              ],
              "buttons": [
                {
                  "action": "refresh-catalogs",
                  "label": "Refresh lists now"
                }
              ]
            }
          ]
        }
      ]
    },
    "spaces": [
      {
        "id": "library",
        "name": "Vault",
        "icon": "lock",
        "layout": "video",
        "locked": true,
        "render": "addon",
        "proxyImages": true
      }
    ],
    "services": {
      "uses": [
        "debrid"
      ]
    },
    "automations": [
      {
        "id": "refresh-catalogs",
        "name": "Refresh adult catalogs",
        "description": "Rebuilds Vault's lists (New in VR, VR studios, New releases, studios — releases cached on the debrid only) and pulls new VR studio releases.",
        "intervalMinutes": 240
      }
    ]
  },
